{
  "name": "servicecrewai-mobile",
  "version": "1.0.0",
  "description": "ServiceCrew AI Mobile App for iOS",
  "main": "dist/app.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "check": "node --check src/app.js && node --check scripts/build.cjs",
    "test": "node --test runtime/test-runtime.cjs",
    "migrate": "node runtime/migrate.cjs",
    "create-admin": "node runtime/create-admin.cjs",
    "sync": "npm run build && cap sync ios",
    "open": "cap open ios",
    "run:ios": "npm run build && cap run ios"
  },
  "keywords": [
    "field-service",
    "hvac",
    "plumbing",
    "electrical",
    "mobile"
  ],
  "author": "ServiceCrew AI",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/camera": "^7.0.2",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/geolocation": "^7.1.6",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/push-notifications": "^7.0.3"
  }
}
